{
  "name": "lianes-library-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-10",
  "containers": [
    {
      "class_name": "LianesApi",
      "image": "docker.io/jeorgec/lianes-library-api:520f8a9380429fd7237640ab93fd45af1d322df0",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIANES_API",
        "class_name": "LianesApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LianesApi"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lianes-library",
      "database_id": "fde93a16-e54f-41d2-873b-d39d5be7cb7b",
      "migrations_dir": "migrations"
    }
  ],
  // Staggered so each job only reads state the previous one has already
  // written (see the scheduled() switch in src/index.ts):
  //   Mon 6am — literary-events discovery (weekly; events don't change hourly)
  //   8am     — overdue-loan + borrow-due-soon detection (in-app + borrower emails)
  //   9am     — wishlist price check (external API calls, needs its own slot)
  //   10am    — consolidated digest email to the owner (Resend)
  "triggers": {
    "crons": ["0 6 * * 1", "0 8 * * *", "0 9 * * *", "0 10 * * *"]
  },
  // Non-secret values can live here as [vars]; secrets below must be set
  // individually via `wrangler secret put <NAME>` before deploying —
  // do not put real credentials in this file.
  //
  // Secrets used by this Worker (all optional — every job that reads one
  // degrades gracefully when it's unset, see src/email.ts, src/wishlist.ts
  // and src/events.ts):
  //   RESEND_API_KEY       — real email sends via Resend; unset = mock-logged to console
  //   RESEND_FROM_EMAIL    — defaults to "Liane's Library <onboarding@resend.dev>"
  //   GOOGLE_BOOKS_API_KEY — raises the wishlist price-check rate limit above 100 req/day
  //   TICKETMASTER_API_KEY — literary-events discovery; unset = only manually-added events show
  "vars": {
    "PINECONE_INDEX_NAME": "lianes-library"
  }
}

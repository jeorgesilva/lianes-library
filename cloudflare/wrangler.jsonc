{
  "name": "lianes-library-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-10",
  "containers": [
    {
      "class_name": "LianesApi",
      "image": "docker.io/jeorgec/lianes-library-api:46b84eb3dfa846a5cccf954ac16477c652633fc1",
      "instance_type": "standard-1",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIANES_API",
        "class_name": "LianesApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LianesApi"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lianes-library",
      "database_id": "fde93a16-e54f-41d2-873b-d39d5be7cb7b",
      "migrations_dir": "migrations"
    }
  ],
  // Daily overdue-loan check + reminder emails (currently logged, not sent —
  // see cloudflare/src/notifications.ts). 8am UTC.
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  // Non-secret values can live here as [vars]; secrets below must be set
  // individually via `wrangler secret put <NAME>` before deploying —
  // do not put real credentials in this file.
  "vars": {
    "PINECONE_INDEX_NAME": "lianes-library"
  }
}
